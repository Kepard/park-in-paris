{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/projects/park-in-paris/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/projects/park-in-paris/",
      "destination": "/index.html"
    },
    {
      "source": "/projects/park-in-paris/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/projects/park-in-paris/data/:path*",
      "destination": "/data/:path*"
    },
    {
      "source": "/projects/park-in-paris/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/projects/park-in-paris/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projects/park-in-paris",
      "destination": "https://parkinparis.kepard.dev/",
      "permanent": true
    },
    {
      "source": "/projects/park-in-paris/",
      "destination": "https://parkinparis.kepard.dev/",
      "permanent": true
    }
  ]
}
